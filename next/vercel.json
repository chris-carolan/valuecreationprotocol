{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "git config --global url.\"https://${GITHUB_TOKEN}@github.com/\".insteadOf \"https://github.com/\" && npm install",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    { "source": "/unified-views/customer", "destination": "https://valuefirstteam.com/language-of-value/unified-customer-view", "permanent": true },
    { "source": "/unified-views/revenue-view", "destination": "https://valuefirstteam.com/language-of-value/unified-revenue-view", "permanent": true },
    { "source": "/unified-views/business-context", "destination": "https://valuefirstteam.com/language-of-value/unified-business-context", "permanent": true },
    { "source": "/unified-views/team-enablement", "destination": "https://valuefirstteam.com/language-of-value/unified-team-enablement", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://valuefirstdesign.com"
        },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
